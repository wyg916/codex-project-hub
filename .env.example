# Reference only. The current launch scripts do not automatically load .env.
# Set these values in the process environment before running start.bat or dev.bat.

# Local runtime directory for SQLite, logs, and PID files.
CPC_DATA_DIR=./data

# Foreground project polling interval in seconds. Values below 1 become 1.
CPC_SCAN_INTERVAL=4

# Set to 1 to disable watchdog and background polling.
CPC_DISABLE_BACKGROUND=0

# Native directory selection and local open actions are disabled by default.
# Set to exactly 1 only when these actions are explicitly wanted.
CPC_ENABLE_SYSTEM_ACTIONS=0

# Optional comma-separated additional explicit HTTP(S) origins.
# Built-in loopback origins remain allowed; non-root paths, credentials, queries, and fragments are rejected.
CPC_ALLOWED_ORIGINS=

# Set to 1 to keep start.bat from opening the browser.
CPC_NO_BROWSER=0
